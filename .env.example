# Copy to .env and fill in the values:
#   cp .env.example .env

# --- Traefik / domain -------------------------------------------------
# Subdomain that points (A record) at this VPS. Traefik requests the
# TLS cert and routes HTTPS traffic for this host to the webhook.
DOMAIN=

# --- Webhook auth --------------------------------------------------------
# Shared secret TradingView must send in every alert payload.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- IBKR Gateway login ----------------------------------------------
# Paper-trading credentials while testing; switch to live credentials
# only once the wiring is validated (see README "Go live" section).
IB_USERID=
IB_PASSWORD=

# paper or live -- must match the IB_USERID/IB_PASSWORD account type.
TRADING_MODE=paper

# 4004 = paper trading, 4003 = live. Must match TRADING_MODE.
IB_PORT=4004

# ib_insync client id for the webhook's connection to IB Gateway.
IB_CLIENT_ID=7

# --- Order/contract defaults -------------------------------------------
DEFAULT_EXCHANGE=SMART
DEFAULT_CURRENCY=USD
DEFAULT_SEC_TYPE=STK

# --- Account currency & sizing -----------------------------------------
# Account base currency, used for cash checks and risk sizing.
ACCOUNT_CURRENCY=EUR
FX_PAIR=EURUSD

# fixed_shares or fixed_risk. Start with fixed_shares while validating
# the wiring, then switch to fixed_risk once confidence is established.
SIZING_MODE=fixed_shares
FIXED_SHARES_QTY=1
FIXED_RISK_EUR=100.0
MAX_POSITION_EUR=50000.0

# --- Entry guardrails ----------------------------------------------------
# Max allowed bid/ask spread, in percent (0.05 = 0.05%).
MAX_SPREAD_PCT=0.05

# --- Trading window (UTC) ----------------------------------------------
# 16-21 CEST and 15-20 CET are both 14:00-19:00 UTC, so this single
# fixed window covers both halves of the year with no DST handling.
TRADING_START_UTC_HOUR=14
TRADING_END_UTC_HOUR=19

# --- Safety ----------------------------------------------------------------
# If true, alerts are validated/sized/checked but no order is sent to IBKR.
# Keep true for the first test run.
DRY_RUN=true
