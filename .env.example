# Copy to .env and fill in the values:
#   cp .env.example .env

# --- Traefik / domain -------------------------------------------------
# Subdomain that points (A record) at this VPS. Traefik requests the
# TLS cert and routes HTTPS traffic for this host to the webhook.
DOMAIN=

# --- Webhook auth --------------------------------------------------------
# Shared secret TradingView must send in every alert payload.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- IBKR Gateway login ----------------------------------------------
# Paper-trading credentials while testing; switch to live credentials
# only once the wiring is validated (see README "Go live" section).
IB_USERID=
IB_PASSWORD=

# paper or live -- must match the IB_USERID/IB_PASSWORD account type.
TRADING_MODE=paper

# 4004 = paper trading, 4003 = live. Must match TRADING_MODE.
IB_PORT=4004

# ib_insync client id for the webhook's connection to IB Gateway.
IB_CLIENT_ID=7

# --- Order/contract defaults -------------------------------------------
DEFAULT_EXCHANGE=SMART
DEFAULT_CURRENCY=USD
DEFAULT_SEC_TYPE=STK

# --- Account currency & sizing -----------------------------------------
# Account base currency, used for cash checks and risk sizing.
ACCOUNT_CURRENCY=EUR
FX_PAIR=EURUSD

# fixed_shares or fixed_risk. Start with fixed_shares while validating
# the wiring, then switch to fixed_risk once confidence is established.
SIZING_MODE=fixed_shares
FIXED_SHARES_QTY=1

# Risk per trade in USD (entry and stop arrive from TradingView in USD).
# Entry 250.00 with stop 249.50 is 0.50 per share, so 100 buys 200 shares.
FIXED_RISK_USD=100.0

# Notional ceiling per position. Binds long before the risk budget does
# when stops are tight, and the bot logs "Position cap bound" when it does.
MAX_POSITION_EUR=50000.0

# --- Entry guardrails ----------------------------------------------------
# Max allowed bid/ask spread, in percent (0.05 = 0.05%). Tuned for live
# quotes; paper testing on delayed ones usually needs 0.5.
MAX_SPREAD_PCT=0.05

# Trade on delayed quotes when IBKR withholds the real-time entitlement
# (it grants it to only one active session, so your own login takes it
# away from the gateway). Prices are then up to 15 minutes old -- paper
# testing only, never live.
ALLOW_DELAYED_MARKET_DATA=false

# --- Trading window (UTC) ----------------------------------------------
# 16-21 CEST and 15-20 CET are both 14:00-19:00 UTC, so this single
# fixed window covers both halves of the year with no DST handling.
TRADING_START_UTC_HOUR=14
TRADING_END_UTC_HOUR=19

# --- Safety ----------------------------------------------------------------
# If true, alerts are validated/sized/checked but no order is sent to IBKR
# -- the response comes back as {"status": "dry_run"}. Set it to true if you
# want to watch the checks run without any order being placed.
DRY_RUN=false
